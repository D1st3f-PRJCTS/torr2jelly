# Torr2Jelly Configuration Template
# Copy this file to .env and adjust variables as needed

# Network ports and URLs
TORRSERVER_URL=http://torrserver:8090
JELLYFIN_STREAM_TORR_URL=http://torrserver:8090
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=your_jellyfin_api_key_here

# Prowlarr indexer aggregator
PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=your_prowlarr_api_key_here

# STRM storage and synchronization
MEDIA_DIR=/media
AUTO_SYNC=true
SYNC_INTERVAL=30

# Interface Language (en or uk - default: en)
LANGUAGE=en

# Security (Persistent JWT Token Signing)
# If left empty, Torr2Jelly will automatically generate a cryptographically secure key and store it in settings.json
JWT_SECRET=

# Optional: Initial Admin Seed (only used on the first startup if 0 users exist)
# If not provided, Torr2Jelly prompts for admin creation on the web UI first-run screen
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
